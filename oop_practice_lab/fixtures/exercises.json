    "fields": {
      "title": "Shape Polymorphism",
      "description": "Model an abstract Shape API with area() and perimeter(), then create Circle and Rectangle subclasses that implement the same methods for polymorphic use.",
      "difficulty": "hard",
      "concepts": [5, 6, 3],
      "starter_code": "class Shape:\n    def area(self):\n        raise NotImplementedError\n\n    def perimeter(self):\n        raise NotImplementedError\n\n\nclass Circle(Shape):\n    pass\n\n\nclass Rectangle(Shape):\n    pass\n\n\nshapes = []\nfor shape in shapes:\n    # TODO: call area() and perimeter() polymorphically\n    pass\n",
      "expected_behavior": "Shape defines area() and perimeter(). Circle and Rectangle inherit Shape and override both methods so a loop can call the same methods on different shape objects.",
      "created_at": "2026-01-03T00:00:00Z"
    }
  },
