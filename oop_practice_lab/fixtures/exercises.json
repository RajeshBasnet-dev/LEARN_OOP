    "fields": {
      "title": "Manager Inherits Employee",
      "description": "Create a Manager subclass of Employee. Use inheritance, call the parent initializer with super(), and override calculate_bonus() for manager-specific behavior.",
      "difficulty": "medium",
      "concepts": [3, 4],
      "starter_code": "class Employee:\n    def __init__(self, name, salary):\n        self.name = name\n        self._salary = salary\n\n    def calculate_bonus(self):\n        return self._salary * 0.10\n\n\nclass Manager(Employee):\n    # TODO: call super().__init__()\n    # TODO: override calculate_bonus()\n    pass\n",
      "expected_behavior": "Manager must inherit from Employee, initialize through super().__init__(), and redefine calculate_bonus().",
      "created_at": "2026-01-02T00:00:00Z"
    }
  },
  {
    "model": "exercises.exercise",
